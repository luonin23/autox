{
  "name": "钉钉上班打卡",
  "description": "打开钉钉，进入工作台考勤打卡，点击上班打卡，处理确认弹窗",
  "steps": [
    { "action": "launch", "target": "钉钉", "delay": 5000 },
    { "action": "click", "target": "工作台", "delay": 3000 },
    { "action": "click", "target": "考勤打卡", "delay": 5000 },
    { "action": "click", "target": "上班打卡", "delay": 3000 },
    {
      "action": "if",
      "condition": { "type": "exists", "target": "确定" },
      "then": [
        { "action": "click", "target": "确定", "delay": 2000 }
      ]
    },
    {
      "action": "if",
      "condition": { "type": "exists", "target": "确认" },
      "then": [
        { "action": "click", "target": "确认", "delay": 2000 }
      ]
    },
    { "action": "toast", "target": "✅ 钉钉上班打卡完成" },
    { "action": "done" }
  ]
}
